{
  "name": "@aduverger/pi-rex",
  "version": "0.0.1",
  "description": "Compact, foldable Pi tool output in Rex on iOS.",
  "scripts": {
    "typecheck": "tsc --noEmit",
    "test": "node --test test/*.test.ts",
    "verify:package": "node scripts/verify-package.mjs",
    "pack:check": "npm_config_cache=.npm-cache npm pack --dry-run && npm run verify:package",
    "check": "npm run typecheck && npm test && npm run verify:package",
    "prepack": "npm run check"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/aduverger/pi-rex.git"
  },
  "homepage": "https://github.com/aduverger/pi-rex#readme",
  "homepage": "https://github.com/aduverger/pi-rex#readme",
  "bugs": {
    "url": "https://github.com/aduverger/pi-rex/issues"
  },
  "type": "module",
  "license": "MIT",
  "author": "Alexandre Duverger",
  "keywords": [
    "pi-package",
    "pi-extension",
    "rex",
    "mobile"
  ],
  "files": [
    "src/",
    "README.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=22.19.0"
  },
  "peerDependencies": {
    "@earendil-works/pi-coding-agent": "*",
    "@earendil-works/pi-tui": "*"
  },
  "devDependencies": {
    "@earendil-works/pi-coding-agent": "1.4.0",
    "@earendil-works/pi-tui": "1.4.0",
    "@types/node": "^24.0.0",
    "typescript": "^6.0.3"
  },
  "publishConfig": {
    "access": "public"
  },
  "pi": {
    "extensions": ["./src/index.ts"]
  }
}
